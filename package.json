{
  "name": "blog-draft-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "cf-typegen": "wrangler types src/worker-bindings.d.ts --env-interface WorkerBindings --include-runtime false --strict-vars false",
    "audit": "npm audit --audit-level=high",
    "pretest": "npm run skills:verify && npm run test:publication",
    "test": "vitest run",
    "skills:verify": "node scripts/verify-marketing-skills.mjs",
    "migrate:local": "wrangler d1 migrations apply blog_studio --local",
    "migrate:remote": "wrangler d1 migrations apply blog_studio --remote",
    "test:publication": "node --test scripts/publication-checks.mjs"
  },
  "dependencies": {
    "cfb": "1.2.2",
    "codepage": "1.15.0",
    "fflate": "^0.8.2",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "~3.1.0",
    "wrangler": "^4.110.0"
  }
}
